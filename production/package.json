    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "node scripts/test-sql.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "setup": "node scripts/setup.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:studio": "supabase status -o env | grep STUDIO || supabase status",
    "db:rebuild": "node scripts/rebuild-db.mjs --local",
    "db:compare": "node scripts/db-compare.mjs",
    "migration:new": "node scripts/new-migration.mjs",
