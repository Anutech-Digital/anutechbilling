{
  "name": "resellersos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "gate": "node --no-warnings scripts/gate.mjs",
    "start": "next start",
    "lint": "next lint",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "typecheck": "tsc --noEmit",
    "backup:code": "node scripts/backup-code.mjs",
    "backup:db": "node scripts/backup-db.mjs ../../resellersos-backups",
