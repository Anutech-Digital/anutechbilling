# R-1412 queue-watch — copy to .queue-watch.env (gitignored) and fill in. Never commit the real file.
AGENT_QUEUE_TOKEN=replace-with-the-agent-queue-token
# Optional, when local and staging use different tokens:
# AGENT_QUEUE_TOKEN_LOCAL=
# AGENT_QUEUE_TOKEN_STAGING=
# Optional base-URL overrides:
# QUEUE_WATCH_LOCAL_URL=http://localhost:3001
# QUEUE_WATCH_STAGING_URL=
