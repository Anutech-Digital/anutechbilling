# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGc..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGc..."  # server-only, NEVER expose

# ============================================================
# Razorpay (test mode initially)
# ============================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# ============================================================
# GST e-invoice (via ClearTax or NIC IRP)
# ============================================================
GST_IRP_API_URL="https://einvapi.cleartax.in/..."
GST_IRP_USERNAME=""
GST_IRP_PASSWORD=""
GST_IRP_CLIENT_ID=""

# ============================================================
# Google Workspace Reseller (CSP)
# ============================================================
GOOGLE_CSP_CLIENT_ID=""
GOOGLE_CSP_CLIENT_SECRET=""
GOOGLE_CSP_REFRESH_TOKEN=""
GOOGLE_CSP_RESELLER_ID=""

# ============================================================
# WhatsApp Business API (via Gupshup BSP)
# ============================================================
WHATSAPP_BSP="gupshup"
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME=""
GUPSHUP_SOURCE_NUMBER=""

# ============================================================
# Email (Resend)
# ============================================================
RESEND_API_KEY="re_..."
EMAIL_FROM="ResellerOS <noreply@resellersos.com>"
EMAIL_REPLY_TO="support@resellersos.com"

# ============================================================
# AI (Gemini for in-app suggestions)
# ============================================================
GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-1.5-flash"

# ============================================================
# Google Contacts sync (dedicated OAuth client — NOT the CSP one)
# People API + contacts scope. Redirect URI to register in Google Cloud:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google-contacts/callback
# ============================================================
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ============================================================
# Monitoring
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="resellersos.com"

# ============================================================
# Customer Panel provisioning (write path)
# ============================================================
# Used by the "Also create Customer Panel account" checkbox on the customer
# form. Must match Customer Panel's BILLING_PROVISION_API_KEY exactly.
CUSTOMER_PANEL_API_URL=""
CUSTOMER_PANEL_PROVISION_API_KEY=""
# Must match Customer Panel's BILLING_COMMAND_API_KEY exactly.
CUSTOMER_PANEL_COMMAND_API_KEY=""

# ============================================================
# Domain/hosting renewal cutover (Stage 4)
# ============================================================
# Leave unset/false — shadow mode (logs what WOULD happen, no real
# suspend action). Only set to "true" after a real observation period
# comparing shadow logs against Customer Panel's own live renewal worker.
DOMAIN_HOSTING_RENEWAL_LIVE="false"

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
