# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (sensitive — never commit)
.env*.local
.env
# .env.test holds a SERVICE-ROLE key (bypasses RLS). The pattern above does not
# match it — `.env*.local` needs the .local suffix — so it was committable.
.env.test
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.next-check

# Cloud SQL migration — never commit filled secrets
supabase/cloudsql/*.secret.sql
supabase/cloudsql/.env*
supabase/cloudsql/phase2/.env
!supabase/cloudsql/phase2/.env.example

# Prisma client — generated by `prisma generate` (part of build/typecheck)
/src/server/db/generated/
